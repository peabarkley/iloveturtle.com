import os
from datetime import datetime

def generate_sitemap(article_dir='article'):
    """自动生成 sitemap.xml"""
    base_url = 'https://www.iloveturtle.com'
    today = datetime.now().strftime('%Y-%m-%d')
    
    xml = '''<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{}/</loc>
    <lastmod>{}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{}/category/</loc>
    <lastmod>{}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
'''.format(base_url, today, base_url, today)
    
    # 遍历 article 文件夹
    if os.path.exists(article_dir):
        for filename in os.listdir(article_dir):
            if filename.endswith('.html'):
                name = filename[:-5]  # 去掉 .html
                xml += '''  <url>
    <loc>{}/article/{}.html</loc>
    <lastmod>{}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
'''.format(base_url, name, today)
    
    xml += '</urlset>'
    
    # 写入文件
    with open('sitemap.xml', 'w', encoding='utf-8') as f:
        f.write(xml)
    
    print(f"Sitemap generated with {len(os.listdir(article_dir))} articles")

# 在你的脚本末尾调用
if __name__ == '__main__':
    # ... 你原有的代码 ...
    generate_sitemap()
